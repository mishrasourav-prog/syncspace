{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["node"],
    "typeRoots": [
  "./node_modules/@types",
  "./src/types"
],

    "sourceMap": true
  },

  "include": ["src/**/*","src/**/*.ts",
  "src/**/*.d.ts"],

  "exclude": [
    "node_modules",
    "dist"
  ]
}